try:
    import CivilCvCAD as app
except ModuleNotFoundError:
    # sys.path modification has not happened yet

    import sys as _sys
    import os as _os

    # 1. we check if an env-variable "PATH_TO_CIVILCVCAD_LIB" is already set
    try:
        _path_to_civilcvcad_libdir = _os.environ["PATH_TO_CIVILCVCAD_LIBDIR"]
    except KeyError:

        # 2. we use the default civilcvcad defined for this package
        _path_to_civilcvcad_libdir = "${CIVILCVCAD_LIBRARY_INSTALL_DIR}"
        print("PATH_TO_CIVILCVCAD_LIBDIR not specified, using default \
CivilCvCAD version in {}".format("${CIVILCVCAD_LIBRARY_INSTALL_DIR}"))

    _sys.path.append(_path_to_civilcvcad_libdir) # this is the default version
    import CivilCvCAD as app

# as this is a namespace-package we need to extend the path

#!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# TO NOT OVERWRITE THIS FILE, NO OTHER MODULE IS ALLOWED TO      !
# PROVIDE A civilcvcad/__init__.py FILE                             !
#!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

from pkgutil import extend_path as _extend_path
__path__ = _extend_path(__path__, __name__)
